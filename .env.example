# ============================================================
# TeamPulse — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# ============================================================

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role (SERVER ONLY, bypasses RLS — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cerebras — SERVER ONLY (primary AI: moderation + cycle summaries)
CEREBRAS_API_KEY=csk-...

# Groq — SERVER ONLY (fallback AI when Cerebras is unavailable)
GROQ_API_KEY=gsk_...

# Resend — SERVER ONLY (transactional email: "you received feedback" notifications)
# Get a key at https://resend.com. Leave unset to disable email sending entirely.
RESEND_API_KEY=re_...
# Verified sender. Use onboarding@resend.dev for testing without a domain.
EMAIL_FROM=TeamPulse <onboarding@resend.dev>

# Public site URL — used to build the board link inside notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
